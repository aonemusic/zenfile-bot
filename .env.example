# Required: token created for your bot with @BotFather. Keep it secret.
BOT_TOKEN=

# Optional single numeric Telegram user ID for admin-only commands.
# Use 0 to leave admin access unconfigured; usernames are not accepted.
ADMIN_ID=0

# App-level transfer guards in MiB; keep below standard Bot API limits.
MAX_INPUT_MB=18
MAX_OUTPUT_MB=49

# Workload limits (defaults shown).
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=300
MAX_PDF_PAGES=100
MAX_IMAGE_PIXELS=40000000
MAX_ARCHIVE_FILES=500
MAX_ARCHIVE_UNPACKED_MB=250

# Temporary files and logs.
TEMP_DIR=/tmp/zenfile
LOG_LEVEL=INFO

# Polling is the default. For webhook mode set BOT_MODE=webhook and provide a
# public HTTPS base URL. The application must be reachable on PORT at WEBHOOK_PATH.
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_PATH=zenfile-webhook
WEBHOOK_SECRET=
PORT=10000
